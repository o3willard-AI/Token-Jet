def _select_server_bin(model_path: str) -> str:
    """Return the llama-server binary path for the given model."""
    basename = os.path.basename(model_path).lower()
    if any(p in basename for p in _PRISM_MODEL_PATTERNS):
        prism_dir = os.path.expanduser(
            _cfg("prism_llama_cpp_bin", str(_HOME / "llama.cpp-prism/build/bin"))
        )
        prism_bin = os.path.join(prism_dir, "llama-server")
        if os.path.isfile(prism_bin) and os.access(prism_bin, os.X_OK):
            return prism_bin
        # Prism fork not built yet — fall through to standard binary with a warning.
        print("WARNING: Bonsai model detected but prism fork not found at:")
        print(f"  {prism_bin}")
        print("GPU inference will not work. Build the prism fork:")
        print("  git clone --branch pr/q2_0-cuda https://github.com/PrismML-Eng/llama.cpp ~/llama.cpp-prism")
        print("  cd ~/llama.cpp-prism && cmake -B build -DGGML_CUDA=ON -DCMAKE_CUDA_ARCHITECTURES=87 && cmake --build build -j6 --target llama-server")
    bin_dir = os.path.expanduser(
        _cfg("llama_cpp_bin", str(_HOME / "llama.cpp/build/bin"))
    )
    return os.path.join(bin_dir, "llama-server")


def _infer_model_info(model_path: str) -> dict:
    """Return model metadata from the known list, or estimate from file size."""
    basename = os.path.basename(model_path)
    for m in MODELS.values():
        if os.path.basename(m["path"]) == basename:
            return m
    try:
        size_gb = os.path.getsize(model_path) / (1024 ** 3)
    except OSError:
        size_gb = 4.0
    return {
        "name": os.path.splitext(basename)[0],
        "size_gb": size_gb,
        "speed_ts": None,
        "max_ctx": 32768,
    }


