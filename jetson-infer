SAFETY_MARGIN_MB = 512  # Leave 512 MB for OS
MIN_FREE_MB = 256       # Minimum free memory after loading
HEALTH_CHECK_INTERVAL = 10  # Seconds between health checks
MEMORY_CHECK_INTERVAL = 30  # Seconds between memory checks
MEMORY_RESTART_THRESHOLD_MB = 200  # Restart if free memory drops below this
MAX_RESTARTS = 10         # Max consecutive restarts before giving up
LOG_FILE = "/tmp/jetson-infer.log"
PID_FILE = "/tmp/jetson-infer.pid"
WATCHDOG_LOG = "/tmp/jetson-watchdog.log"

_HOME = Path.home()


# ── Config reader ────────────────────────────────────────────
def _load_config() -> dict:
    config_path = _HOME / ".config/token-jet/config.toml"
    if not config_path.exists():
        return {}
    # Try proper TOML parser first (stdlib 3.11+, or tomli backport on 3.10)
    try:
        if sys.version_info >= (3, 11):
            import tomllib
        else:
            import tomli as tomllib  # type: ignore[no-redef]
        with open(config_path, "rb") as f:
            return tomllib.load(f)
    except ImportError:
        pass  # tomli not installed — fall through to inline parser
    except Exception:
        return {}
    # Inline fallback: handles the simple key = "value" / key = 123 format we write
    result: dict = {}
    try:
        with open(config_path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, val = line.partition("=")
                key = key.strip()
                val = val.strip()
                if val.startswith('"') and val.endswith('"'):
                    result[key] = val[1:-1]
                elif val.lstrip("-").isdigit():
                    result[key] = int(val)
    except Exception:
        pass
    return result

_CONFIG: dict = {}

def _cfg(key: str, default):
    global _CONFIG
    if not _CONFIG:
        _CONFIG = _load_config()
    return _CONFIG.get(key, default)


# ── Model resolution helpers ─────────────────────────────────

def _resolve_model_path(model_arg) -> str:
    """Turn a --model argument (or None) into a full .gguf path."""
    if model_arg:
        if os.path.isabs(model_arg) or model_arg.startswith("~/"):
            path = os.path.expanduser(model_arg)
            if os.path.exists(path):
                return path
        # Try bare filename inside model_dir
        model_dir = _cfg("model_dir", str(_HOME / "models"))
        for candidate in (
            os.path.join(model_dir, model_arg),
            os.path.join(model_dir, model_arg + ".gguf"),
        ):
            if os.path.exists(candidate):
                return candidate
        # Accept as literal path even if it doesn't exist yet; validation in start_server
        return os.path.expanduser(model_arg)

    # No argument — use default_model from config, else first .gguf in model_dir
    import glob
    default = _cfg("default_model", "")
    if default and os.path.exists(os.path.expanduser(default)):
        return os.path.expanduser(default)

    model_dir = _cfg("model_dir", str(_HOME / "models"))
    ggufs = sorted(glob.glob(os.path.join(model_dir, "*.gguf")))
    if ggufs:
        return ggufs[0]

    print(f"No models found in {model_dir}.")
    print("Download one with:  token-jet  →  Ctrl+D")
    sys.exit(1)


def _select_server_bin(model_path: str) -> str:
    """Choose standard or prism llama-server based on the model filename.

    config.toml stores llama_cpp_bin as a directory (build/bin).
    Always append the binary name here so we return an executable path.
    """
    name = os.path.basename(model_path).lower()
    if any(kw in name for kw in ("bonsai", "ternary", "prism")):
        prism_dir = os.path.expanduser(
            _cfg("llama_cpp_prism_bin", str(_HOME / "llama.cpp-prism/build/bin"))
        )
        prism_bin = os.path.join(prism_dir, "llama-server")
        if os.path.isfile(prism_bin) and os.access(prism_bin, os.X_OK):
            return prism_bin
        print(f"Warning: prism binary not found at {prism_bin}, falling back to standard build")
    bin_dir = os.path.expanduser(
        _cfg("llama_cpp_bin", str(_HOME / "llama.cpp/build/bin"))
    )
    return os.path.join(bin_dir, "llama-server")


def _infer_model_info(model_path: str) -> dict:
    """Return model metadata from the known list, or estimate from file size."""
    basename = os.path.basename(model_path)
    for m in MODELS.values():
        if os.path.basename(m["path"]) == basename:
            return m
    try:
        size_gb = os.path.getsize(model_path) / (1024 ** 3)
    except OSError:
        size_gb = 4.0
    return {
        "name": os.path.splitext(basename)[0],
        "size_gb": size_gb,
        "speed_ts": None,
        "max_ctx": 32768,
    }


