            startup_name = os.path.basename(ggufs[0]) + "  (first found)" if ggufs else "(none)"
    print()
    print(f"Will start: {startup_name}")


def switch_model(model_arg: str, port=PORT):
    """Stop the running server and restart with a different model."""
    model_path = _resolve_model_path(model_arg)
    print(f"Switching to: {os.path.basename(model_path)}")
    stop_server()
    time.sleep(2)
    start_server(model_path, port)


def install_service():
    """Install systemd service for auto-start on boot."""
    service_file = Path(__file__).parent / "jetson-infer.service"
    systemd_path = Path.home() / ".config/systemd/user/jetson-infer.service"
    
    if not service_file.exists():
        print(f"Service file not found: {service_file}")
        print("Create jetson-infer.service in the same directory as this script.")
        sys.exit(1)
    
    # Create systemd user directory
    systemd_path.parent.mkdir(parents=True, exist_ok=True)
    
    # Copy service file
    systemd_path.write_text(service_file.read_text())
    print(f"Installed: {systemd_path}")
    
    # Enable and start
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
    subprocess.run(["systemctl", "--user", "enable", "jetson-infer"], check=False)
    print()
    print("Service installed. Commands:")
    print("  systemctl --user start jetson-infer    # Start now")
    print("  systemctl --user status jetson-infer   # Check status")
    print("  systemctl --user stop jetson-infer     # Stop")
    print("  journalctl --user -u jetson-infer -f   # Follow logs")
    print()
    current_user = os.getenv("USER") or Path.home().name
    print("Note: 'linger' must be enabled for user services to start at boot:")
    print(f"  sudo loginctl enable-linger {current_user}")

    # Try to enable linger with sudo
    try:
        subprocess.run(["sudo", "loginctl", "enable-linger", current_user],
                      check=False, timeout=10)
        print("  (linger enabled automatically)")
    except:
        pass


def watchdog_loop(model_path: str, port, max_restarts=MAX_RESTARTS):
    """Monitor server health and memory. Restart on failure."""
    import datetime
    
    wlog = open(WATCHDOG_LOG, "a")
    def wprint(msg):
        ts = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        line = f"[{ts}] {msg}"
        print(line, flush=True)
        wlog.write(line + "\n")
        wlog.flush()
    
    wprint("Watchdog started")
    restart_count = 0
    last_memory_check = 0
    
    while restart_count < max_restarts:
        time.sleep(HEALTH_CHECK_INTERVAL)
        
        # Health check
        healthy = is_running(port)
        
        # Memory check (less frequent)
        now = time.time()
        if now - last_memory_check > MEMORY_CHECK_INTERVAL:
            last_memory_check = now
            free_mb = get_free_memory_mb()
            if free_mb < MEMORY_RESTART_THRESHOLD_MB:
                wprint(f"MEMORY LOW: {free_mb} MB free (threshold: {MEMORY_RESTART_THRESHOLD_MB} MB). Restarting...")
                healthy = False
        
        if not healthy:
            restart_count += 1
            wprint(f"SERVER UNHEALTHY (restart {restart_count}/{max_restarts})")
            
            # Kill existing
            pid = get_pid()
            if pid:
                try:
                    os.kill(pid, signal.SIGTERM)
                    time.sleep(5)
                    os.kill(pid, signal.SIGKILL)
                except:
                    pass
            subprocess.run(["pkill", "-9", "-f", "llama-server"], stderr=subprocess.DEVNULL)
            time.sleep(5)
            
            # Wait for CUDA memory to be reclaimed by the driver before restarting.
            # Threshold: model size + 1 GB margin. /proc/meminfo reflects unified
            # memory, so this also covers GPU memory on Jetson.
            restart_model = _infer_model_info(model_path)
            mem_needed_mb = int(restart_model["size_gb"] * 1024) + 1024
            for _ in range(60):  # up to 2 minutes
                if get_free_memory_mb() >= mem_needed_mb:
                    break
                time.sleep(2)
            
            # Restart
            wprint("Restarting server...")
            try:
                start_server(model_path, port)
                restart_count = 0  # Reset on successful start
                wprint("Server recovered")
            except SystemExit:
                wprint("Start failed. Will retry...")
                time.sleep(30)
    
    wprint(f"MAX RESTARTS ({max_restarts}) REACHED. Watchdog giving up.")
    sys.exit(1)


# ── CLI ─────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        description="jetson-infer — Smart inference server for Jetson Orin Nano",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  jetson-infer start                              Start recommended model
  jetson-infer start --model ~/models/foo.gguf   Start a specific model
  jetson-infer switch qwen3.5-4B-super-coder.Q4_0.gguf   Switch to a different model
  jetson-infer status                             Show server status
  jetson-infer stop                               Stop the server
  jetson-infer models                             List downloaded models
        """
    )
    sub = parser.add_subparsers(dest="command", help="Command")

    start_parser = sub.add_parser("start", help="Start inference server")
    start_parser.add_argument(
        "--model", default=None, metavar="PATH",
        help="Full path to a .gguf model file. "
             "Omit to use default_model from config, or the first .gguf in model_dir.",
    )
    start_parser.add_argument("--port", type=int, default=PORT,
                              help=f"Port to listen on (default: {PORT})")
    start_parser.add_argument("--watchdog", action="store_true",
                              help="Run with health/memory monitoring and auto-restart")

    switch_parser = sub.add_parser("switch", help="Switch to a different model (stops current, starts new)")
    switch_parser.add_argument(
        "model", metavar="MODEL",
        help="Model filename (e.g. qwen3.5-4B-super-coder.Q4_0.gguf), full path, or name key",
    )
    switch_parser.add_argument("--port", type=int, default=PORT)

    sub.add_parser("stop", help="Stop inference server")
    sub.add_parser("status", help="Show server status")
    sub.add_parser("usb-status", help="Show USB gadget state and air-gapped endpoint URLs")
    sub.add_parser("models", help="List downloaded models with estimated context window")
    sub.add_parser("install", help="Install systemd service for auto-start on boot")

    args = parser.parse_args()

    if args.command == "switch":
        switch_model(args.model, args.port)
    elif args.command == "start":
        model_path = _resolve_model_path(args.model)
        if args.watchdog:
            start_server(model_path, args.port)
            watchdog_loop(model_path, args.port)
        else:
            start_server(model_path, args.port)
    elif args.command == "stop":
        stop_server()
    elif args.command == "status":
        show_status()
    elif args.command == "usb-status":
        usb_status()
    elif args.command == "models":
        show_models()
    elif args.command == "install":
        install_service()
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
