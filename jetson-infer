# ── Memory / Context Calculation ────────────────────────────

def get_free_memory_mb():
    """Get available memory in MB from /proc/meminfo."""
    try:
        with open("/proc/meminfo") as f:
            meminfo = f.read()
        # MemAvailable is the best estimate of usable memory
        m = re.search(r"MemAvailable:\s+(\d+)\s+kB", meminfo)
        if m:
            return int(m.group(1)) // 1024
        # Fallback: MemFree + Cached
        free = re.search(r"MemFree:\s+(\d+)\s+kB", meminfo)
        cached = re.search(r"Cached:\s+(\d+)\s+kB", meminfo)
        if free and cached:
            return (int(free.group(1)) + int(cached.group(1))) // 1024
    except:
        pass
    return 1024  # Conservative default


def calculate_max_context(model_info, free_memory_mb):
    """Calculate the largest context window that fits in available memory.

    KV cache cost per token = 2 * n_kv_heads * head_dim * n_layers * 2 bytes (fp16).
    Validated empirically on Bonsai-8B: theoretical matches observed consumption
    on Jetson Orin Nano with no significant overhead.

    Falls back to file-size scaling for unknown models (conservative).
    """
    available_mb = free_memory_mb - model_info["size_gb"] * 1024 - SAFETY_MARGIN_MB
    if available_mb < MIN_FREE_MB:
        available_mb = MIN_FREE_MB

    if all(k in model_info for k in ("n_kv_heads", "head_dim", "n_layers")):
        # Architecture-based: accurate for any GQA model.
        bytes_per_token = (2 * model_info["n_kv_heads"] * model_info["head_dim"]
                           * model_info["n_layers"] * 2)
        kb_per_token = bytes_per_token / 1024
    else:
        # Unknown model: size-based fallback (conservative — may undercount context).
        kb_per_token = 144 * (model_info["size_gb"] / 2.03)

    kv_budget_mb = available_mb * 0.85  # 15% headroom for CUDA overhead

    max_ctx = int(kv_budget_mb / (kb_per_token / 1024))
    max_ctx = min(max_ctx, model_info["max_ctx"], MAX_CTX_HARD_CAP)
    max_ctx = max(max_ctx, 2048)

    # Round down to nearest power-of-2-ish step so llama.cpp gets a clean value.
    steps = [2048, 4096, 6144, 8192, 12288, 16384, 20480, 24576, 32768,
             49152, 65536, 98304, 131072]
    for i, step in enumerate(steps):
        if step > max_ctx:
            max_ctx = steps[i - 1] if i > 0 else steps[0]
            break
    else:
        max_ctx = steps[-1]
    return max_ctx


# ── Server Management ───────────────────────────────────────

def is_running(port=PORT):
    """Check if server is currently running and healthy."""
    try:
        import urllib.request
        r = urllib.request.urlopen(f"http://127.0.0.1:{port}/health", timeout=2)
        return b'"status":"ok"' in r.read()
    except:
        return False


def get_pid():
    """Get PID of running server from PID file."""
    try:
        with open(PID_FILE) as f:
            return int(f.read().strip())
    except:
        return None


def start_server(model_path: str, port=PORT):
    """Start llama-server for the given .gguf model file."""
    model_path = os.path.expanduser(model_path)

    if not os.path.exists(model_path):
        print(f"Model file not found: {model_path}")
        sys.exit(1)

    if is_running(port):
        print("Server already running. Use 'jetson-infer stop' first.")
        sys.exit(1)

    model = _infer_model_info(model_path)
    server_bin = _select_server_bin(model_path)

    if not os.path.isfile(server_bin) or not os.access(server_bin, os.X_OK):
        print(f"llama-server not found or not executable: {server_bin}")
        print("Run the Token-Jet installer to build llama.cpp.")
        sys.exit(1)

    free_mb = get_free_memory_mb()
    ctx_size = calculate_max_context(model, free_mb)

    print(f"Model:    {model['name']}")
    print(f"File:     {model_path}")
    print(f"Size:     {model['size_gb']:.2f} GB")
    if model.get("speed_ts"):
        print(f"Speed:    {model['speed_ts']} t/s")
    print(f"Free RAM: {free_mb} MB")
    print(f"Context:  {ctx_size} tokens")
    print(f"Endpoint: http://{HOST}:{port}")
    print(f"Chat API: http://{HOST}:{port}/v1/chat/completions")
    print()

    env = os.environ.copy()
    env["LD_LIBRARY_PATH"] = _cfg("ld_library_path", LD_LIBRARY_PATH)

    cmd = [
        server_bin,
        "-m", model_path,
        "--host", HOST,
        "--port", str(port),
        "--n-gpu-layers", "99",
        "--ctx-size", str(ctx_size),
        "--metrics",
        # Always enabled: harmless no-op for non-thinking models; required for
        # any model that generates <think>...</think> blocks (Qwen3, MiniCPM,
        # DeepSeek-R1, Phi-4-reasoning, etc.) so llama-server routes thinking
        # tokens into reasoning_content instead of stopping at </think>.
        "--reasoning", "auto",
    ]

    # Cap thinking tokens. 0 = no cap (model default). Tune in config.toml:
    #   reasoning_budget = 1024
    reasoning_budget = int(_cfg("reasoning_budget", 0))
    if reasoning_budget > 0:
        cmd += ["--reasoning-budget", str(reasoning_budget)]

    print(f"Starting: {' '.join(cmd)}")
    print(f"Logs: {LOG_FILE}")

    with open(LOG_FILE, "w") as log:
        proc = subprocess.Popen(cmd, stdout=log, stderr=subprocess.STDOUT, env=env)

    with open(PID_FILE, "w") as f:
        f.write(str(proc.pid))

    print("Waiting for server to become healthy...", end="", flush=True)
    for i in range(300):  # 10 minutes max
        time.sleep(2)
        if proc.poll() is not None:
            print(f" process exited (code {proc.returncode})!")
            print(f"Check logs: tail -f {LOG_FILE}")
            sys.exit(1)
        if is_running(port):
            print(f" ready! ({i*2}s)")
            print()
            print("Server is running. Agents can connect at:")
            print(f"  http://<jetson-ip>:{port}/v1/chat/completions")
            return
        print(".", end="", flush=True)

    print(" timeout!")
    print("Check logs: tail -f", LOG_FILE)
    sys.exit(1)


def stop_server():
    """Stop the running server."""
    pid = get_pid()
    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
            time.sleep(2)
            print("Server stopped.")
        except ProcessLookupError:
            print("Server was not running.")
        except Exception as e:
            print(f"Error stopping server: {e}")
    else:
        # Fallback: kill all llama-server processes
        subprocess.run(["pkill", "-f", "llama-server"], stderr=subprocess.DEVNULL)
        print("Server stopped (pkill fallback).")
    
    # Clean up
    for f in [PID_FILE]:
        try:
            os.remove(f)
        except:
            pass


def _get_local_ip() -> str:
    """Return the primary LAN IP by probing a UDP socket (no traffic sent)."""
    try:
        import socket
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return HOST


def show_status():
    """Show current server status."""
    import urllib.request
    local_ip = _get_local_ip()

    if is_running():
        print("Server: RUNNING")
        print(f"URL:   http://{local_ip}:{PORT}")
        print(f"Chat:  http://{local_ip}:{PORT}/v1/chat/completions")

        pid = get_pid()
        if pid:
            print(f"PID:   {pid}")

        try:
            resp = json.loads(urllib.request.urlopen(
                urllib.request.Request(f"http://127.0.0.1:{PORT}/v1/models"),
                timeout=5).read())
            for m in resp.get("data", []):
                print(f"Model: {m.get('id', 'unknown')}")
        except Exception:
            pass

        free_mb = get_free_memory_mb()
        print(f"Free:  {free_mb} MB")
    else:
        print("Server: NOT RUNNING")
        free_mb = get_free_memory_mb()
        print(f"Free:  {free_mb} MB")

    try:
        urllib.request.urlopen(f"http://127.0.0.1:{PI_WEB_PORT}", timeout=2)
        pi_status = "running"
    except Exception:
        pi_status = "not running"
    print(f"pi-web: http://{local_ip}:{PI_WEB_PORT}  [{pi_status}]")

    try:
        urllib.request.urlopen(f"http://127.0.0.1:{DUFS_PORT}", timeout=2)
        dufs_status = "running"
    except Exception:
        dufs_status = "not running"
    print(f"dufs:   http://{local_ip}:{DUFS_PORT}   [{dufs_status}]  (~/shared/)")


def usb_status():
    """Show USB gadget connectivity status and air-gapped endpoint URLs."""
    import re
    import urllib.request

    # ── l4tbr0 state ──────────────────────────────────────────────────────────
    try:
        result = subprocess.run(
            ["ip", "addr", "show", "l4tbr0"],
            capture_output=True, text=True, timeout=3,
        )
        out = result.stdout
        gadget_ready = "192.168.55.1" in out
        cable_in = "state UP" in out and "NO-CARRIER" not in out
    except Exception:
        gadget_ready = False
        cable_in = False

    if not gadget_ready:
        print("USB gadget: NOT CONFIGURED")
        print("  Expected NVIDIA L4T USB device mode at 192.168.55.1")
        print("  Check: systemctl status nv-l4t-usb-device-mode")
        return

    state = "CONNECTED  (cable detected)" if cable_in else "ready  (no cable plugged in)"
    print(f"USB gadget: {state}")
    print(f"  Jetson IP:        192.168.55.1")
    print(f"  Client IP (DHCP): 192.168.55.100")

    # ── Active DHCP lease ─────────────────────────────────────────────────────
    try:
        leases = open("/run/l4t-usb-devmode-dhcpd.leases").read()
        active = re.findall(
            r"lease\s+([\d.]+)\s*\{[^}]*binding\s+state\s+active", leases, re.DOTALL
        )
        print(f"  Active client:    {active[-1] if active else 'none'}")
    except Exception:
        pass

    print()

    # ── Inference server ──────────────────────────────────────────────────────
    try:
        resp = json.loads(urllib.request.urlopen(
            f"http://192.168.55.1:{PORT}/v1/models", timeout=2).read())
        model = (resp.get("data", [{}])[0].get("id", "?") or "?").split("/")[-1].replace(".gguf", "")
        print(f"  Inference API:  http://192.168.55.1:{PORT}/v1  [OK]  ({model})")
    except Exception:
        print(f"  Inference API:  http://192.168.55.1:{PORT}/v1  [not running — jetson-infer start]")

    # ── pi-web ────────────────────────────────────────────────────────────────
    try:
        urllib.request.urlopen("http://192.168.55.1:30141", timeout=2)
        print(f"  pi-web UI:      http://192.168.55.1:30141      [OK]")
    except Exception:
        print(f"  pi-web UI:      http://192.168.55.1:30141      [not running]")

    # ── dufs file share ───────────────────────────────────────────────────────
    try:
        urllib.request.urlopen(f"http://192.168.55.1:{DUFS_PORT}", timeout=2)
        print(f"  File share:     http://192.168.55.1:{DUFS_PORT}      [OK]")
    except Exception:
        print(f"  File share:     http://192.168.55.1:{DUFS_PORT}      [not running]")

    print()
    print("Client setup — Windows 10/11 (build 18362+): no drivers needed.")
    print("  macOS: install HoRNDIS first — https://github.com/jwise/HoRNDIS")
    print("  1. Plug USB-C cable: Jetson  →  Mac or Windows PC")
    print("  2. Wait ~5 sec for the USB Ethernet adapter to appear")
    print("  3. Browser UI:        http://192.168.55.1:30141")
    print("     OpenAI-compat API: http://192.168.55.1:1234/v1")
    print()
    print("No WiFi or Ethernet required. The Jetson is fully air-gapped.")


def show_models():
    """List downloaded GGUF models and their estimated context window."""
    import glob
    model_dir = _cfg("model_dir", str(_HOME / "models"))
    free_mb = get_free_memory_mb()

    ggufs = sorted(glob.glob(os.path.join(model_dir, "*.gguf")))
    if not ggufs:
        print(f"No models found in {model_dir}")
        print("Download one with:  token-jet  →  Ctrl+D")
        return

    print(f"Free memory: {free_mb} MB")
    print(f"Models in {model_dir}:")
    print()
    print(f"{'Model':<52} {'Size':>7}  {'Max Ctx':>8}")
    print("-" * 72)
    for path in ggufs:
        info = _infer_model_info(path)
        ctx = calculate_max_context(info, free_mb)
        print(f"{os.path.basename(path):<52} {info['size_gb']:>5.1f} GB  {ctx:>8}")

    startup_cfg = _cfg("startup_model", "") or _cfg("default_model", "")
    if startup_cfg and os.path.exists(os.path.expanduser(startup_cfg)):
        startup_name = os.path.basename(startup_cfg) + "  (from config)"
    else:
        # Find the recommended model that's actually downloaded
        startup_name = None
        for m in MODELS.values():
