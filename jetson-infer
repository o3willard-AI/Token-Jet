#!/usr/bin/env python3
"""
jetson-infer — Smart inference server for Jetson Orin Nano.

Starts llama-server with the optimal model and context window based on
available shared memory. Exposes an OpenAI-compatible API on the local
network for external agents (PI, OpenCode, etc.).

Usage:
  jetson-infer start              # Start with best model, auto context
  jetson-infer start --model 4B   # Start with specific model
  jetson-infer status             # Show current server status
  jetson-infer stop               # Stop the server
  jetson-infer models             # List available models with scores
"""

