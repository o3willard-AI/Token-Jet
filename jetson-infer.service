[Unit]
Description=Jetson Inference Server (jetson-infer)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h
Environment=LD_LIBRARY_PATH=/usr/local/cuda/targets/sbsa-linux/lib
ExecStart=%h/bin/jetson-infer start --watchdog
ExecStop=%h/bin/jetson-infer stop
Restart=on-failure
RestartSec=10
StandardOutput=append:/tmp/jetson-infer-service.log
StandardError=append:/tmp/jetson-infer-service.log

# Give plenty of time for model loading from slow eMMC
TimeoutStartSec=900

[Install]
WantedBy=default.target
