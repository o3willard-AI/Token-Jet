{
  "model": "jetson-local/local",
  "enableInstallTelemetry": false,
  "PI_SKIP_VERSION_CHECK": true,
  "extensions": ["~/.pi/agent/extensions/jetson-provider.ts", "~/.pi/agent/extensions/wifi-manager.ts"],
  "skills": ["~/Token-Jet/pi/ddg-search"],
  "packages": [
    "npm:pi-mcp-adapter"
  ],
  "thinkingBudgets": {
